# Hyperswitch hosted sandbox.
# Get these from https://app.hyperswitch.io -> Developers -> API Keys

# Server-side only. Never expose to the browser.
HYPERSWITCH_API_KEY=snd_xxxxxxxxxxxxxxxxxxxxxxxx
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io

# Safe to expose. Used by the web SDK to render the payment element.
NEXT_PUBLIC_HYPERSWITCH_PUBLISHABLE_KEY=pk_snd_xxxxxxxxxxxxxxxxxxxxxxxx

# Business profile the payments are created under.
HYPERSWITCH_PROFILE_ID=pro_xxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret configured on the Hyperswitch dashboard webhook settings.
# Used to verify inbound webhook signatures. Required.
HYPERSWITCH_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Signs guest statement access cookies. Any 32+ byte random string.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AFTERCARE_SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public origin of this app. Used to build the 3DS return_url.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared payment ledger. The Upstash integration in the Vercel marketplace sets
# both of these on the deployment automatically, under KV_ prefixed names rather
# than UPSTASH_ ones. Do not add them by hand there: hand-entered copies stop
# matching at the first token rotation. Locally, copy them from the Upstash
# console.
#
# Why a shared store at all, when DESIGN.md section 12 says no database: mutable
# state in module scope is not shared between a Next route handler and a page.
# See DECISIONS.md D-013.
KV_REST_API_URL=https://xxxxxxxxxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
